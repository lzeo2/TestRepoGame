-        connectRoom: (code, name, h) => m.connectRoom(code, name, h),
-        createLocalRoom: (config, name, h) => m.createLocalRoom(config, name, h),
-        listRooms: async () => {
-          const r = await m.listRooms()
-          return Array.isArray(r) ? r : (r?.rooms ?? [])
