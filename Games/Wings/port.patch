+@media (max-width: 760px) {
+  .spawn { overflow-y: auto; padding: 64px 16px 24px; }
+  .sp-head, .spawn .sp-list, .sp-detail, .spawn .foot, .spawn .countdown { position: static; width: 100%; margin: 0 0 24px; }
+  .sp-head .title { font-size: 48px; }
+  .sp-head .teams, .sp-head .tabs { flex-wrap: wrap; gap: 8px; }
+  .sp-detail .thumb { max-width: 320px; margin: 0; }
+  .sp-detail .thumb[hidden] { display: none; }
+  .sp-detail .stats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
+  .sp-detail .seats li { grid-template-columns: 20px minmax(0, 1fr); gap: 6px; }
+  .sp-detail .seats .w { grid-column: 2; }
+  .spawn.guns .sp-list .menu.mid .mi { grid-template-columns: 24px 8px minmax(0, 1fr) auto; }
+  .pause { overflow-y: auto; }
+  .pause .screen { bottom: 64px; overflow-y: auto; }
+  .hud-top { top: 62px; }
+  .hud-radar, .hud-radar canvas { width: 120px; height: 120px; }
+  .hud-radar { left: 12px; bottom: 120px; }
+  .hud-mapwrap, .hud-map { width: 120px; height: 120px; }
+  .hud-mapwrap { right: 12px; bottom: 120px; }
+  .hud-ping { right: 12px; bottom: 248px; }
+  .hud-bottom .weapons { right: 12px; bottom: 270px; }
+  .hud-bottom .seat { bottom: 72px; width: calc(100% - 32px); }
+  .hud-bottom .hp { bottom: 24px; width: calc(100% - 32px); }
+  .hud-tape.left { left: 12px; width: 80px; text-align: left; }
+  .hud-tape.right { left: auto; right: 12px; width: 80px; text-align: right; }
+  .hud-tape .thr { right: 0; }
+  .hud-chat { left: 12px; bottom: 360px; width: calc(100% - 24px); }
+  .hud-feed { top: 140px; padding: 8px 12px; max-width: 100%; }
+  .hud-tur { bottom: 260px; width: calc(100% - 32px); }
+  .hud-hint, .hud-stealth, .hud-turhint { bottom: 92px; max-width: calc(100% - 24px); white-space: normal; }
+  .hud-board { flex-wrap: wrap; gap: 24px; overflow-y: auto; padding: 80px 16px 24px; }
+}
