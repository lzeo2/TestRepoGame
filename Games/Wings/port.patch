+    room.send({ type: 'input', seq: i, flight: { aim: null, throttle: 1, roll: 0, yaw: i > 780 ? 0.15 : 0, pitch: i > 120 ? 0.35 : 0, boost: true, brake: false } })
+    room.step(TICK_DT)
+  }
+  await Promise.resolve()
+  assert(vehicle.alive && !vehicle.flight.onGround)
