diff --git a/games/wings/src/render/ctf.ts b/games/wings/src/render/ctf.ts
new file mode 100644
index 0000000..1d38bd0
--- /dev/null
+++ b/games/wings/src/render/ctf.ts
@@ -0,0 +1,86 @@
+import {
+  BoxGeometry, Color, CylinderGeometry, DynamicDrawUsage, Group, InstancedMesh,
+  Matrix4, MeshBasicNodeMaterial, Quaternion, RingGeometry, Vector3,
+} from "three/webgpu"
+import type { CtfState } from "../sim/ctf"
+import type { Quat, Vec3, VehicleKind } from "../sim/types"
+import { WATER_LEVEL } from "../sim/geography"
+import { VEHICLES } from "../sim/vehicles"
+
+/** Four primitive batches only; carrier poses come from the interpolated visual map. */
+export function createCtfView(route: readonly Vec3[], teamColors: readonly string[]) {
+  if (route.length > 12) throw new RangeError("CTF route supports at most 12 buoys")
+  if (teamColors.length < 2) throw new RangeError("CTF needs two team colors")
+  const root = new Group()
+  root.name = "CTF objectives"
+  root.visible = false
+  const material = new MeshBasicNodeMaterial({ color: "#ffffff" })
+  const homes = new InstancedMesh(new RingGeometry(18, 20, 32).rotateX(-Math.PI / 2), material, 2)
+  const buoys = new InstancedMesh(new CylinderGeometry(1.2, 2, 3, 6).translate(0, 1.5, 0), material, route.length)
+  const poles = new InstancedMesh(new CylinderGeometry(0.12, 0.12, 6, 6).translate(0, 3, 0), material, 2)
+  const banners = new InstancedMesh(new BoxGeometry(4, 2.6, 0.12).translate(2, 4.7, 0), material, 2)
+  homes.name = "CTF homes"
+  buoys.name = "CTF route buoys"
+  poles.name = "CTF poles"
+  banners.name = "CTF banners"
+  const meshes = [homes, buoys, poles, banners]
+  const colors = teamColors.slice(0, 2).map(value => new Color(value))
+  const matrix = new Matrix4()
+  const position = new Vector3()
+  const carrierPosition = new Vector3()
+  const orientation = new Quaternion()
+  const scale = new Vector3(1, 1, 1)
+  for (const mesh of meshes) {
+    for (let i = 0; i < mesh.count; i++) mesh.setColorAt(i, colors[i % 2])
+    if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true
+    root.add(mesh)
+  }
+  for (const mesh of [homes, poles, banners]) mesh.instanceMatrix.setUsage(DynamicDrawUsage)
+  route.forEach((point, i) => {
+    matrix.makeTranslation(point[0], WATER_LEVEL + 0.2, point[2])
+    buoys.setMatrixAt(i, matrix)
+  })
+  buoys.instanceMatrix.needsUpdate = true
+  buoys.computeBoundingSphere()
+  let disposed = false
+  return {
+    root,
+    update(state: CtfState, carriers: ReadonlyMap<string, { pos: Vec3; quat: Quat; kind: VehicleKind }>): void {
+      if (disposed) return
+      state.flags.forEach((flag, i) => {
+        matrix.makeTranslation(flag.home[0], WATER_LEVEL + 0.2, flag.home[2])
+        homes.setMatrixAt(i, matrix)
+        orientation.identity()
+        const carrier = flag.carrierId === null ? undefined : carriers.get(flag.carrierId)
+        if (carrier) {
+          orientation.fromArray(carrier.quat)
+          position.set(0, VEHICLES[carrier.kind].flight === "water" ? 0.8 : 2, 4)
+            .applyQuaternion(orientation).add(carrierPosition.fromArray(carrier.pos))
+        } else {
+          position.fromArray(flag.position)
+        }
+        matrix.compose(position, orientation, scale)
+        poles.setMatrixAt(i, matrix)
+        banners.setMatrixAt(i, matrix)
+      })
+      for (const mesh of [homes, poles, banners]) {
+        mesh.instanceMatrix.needsUpdate = true
+        // InstancedMesh does not invalidate its aggregate sphere when instances move.
+        mesh.computeBoundingSphere()
+      }
+      root.visible = true
+    },
+    dispose(): void {
+      if (disposed) return
+      disposed = true
+      root.visible = false
+      root.removeFromParent()
+      root.clear()
+      for (const mesh of meshes) {
+        mesh.dispose()
+        mesh.geometry.dispose()
+      }
+      material.dispose()
+    },
+  }
+}
