@@ -0,0 +1,25 @@
+import type { SpawnPoint } from "./geography"
+import type { Vec3 } from "./types"
+
+// Current WING seed's real strait between Mainland and Isle 2. No terrain override.
+// C1 planning probes: 1,720m route, 12.45m minimum sampled under-keel clearance.
+// Driven turns and full-mode navigation still require their own regression.
+export const CTF_WATER_ROUTE: readonly Vec3[] = [
+  [-400, 0, 1100], [260, 0, 1100], [260, 0, 840], [800, 0, 840], [800, 0, 1100],
+]
+export const CTF_HOMES: [Vec3, Vec3] = [[-400, 1, 1100], [800, 1, 1100]]
+
+/** Ordinary mode-local spawns. Aircraft air-start; boats retain their waterline/zero-speed factory. */
+export function ctfSpawnPoint(team: 0 | 1, water: boolean, index: number): SpawnPoint {
+  const home = CTF_HOMES[team]
+  const target = water ? CTF_WATER_ROUTE[team === 0 ? 1 : CTF_WATER_ROUTE.length - 2] : CTF_HOMES[1 - team]
+  const length = Math.hypot(target[0] - home[0], target[2] - home[2])
+  const dx = (target[0] - home[0]) / length, dz = (target[2] - home[2]) / length
+  const slot = Math.max(0, Math.floor(index)) % 16
+  const side = (slot % 3 - 1) * 14, back = 20 + Math.floor(slot / 3) * 14
+  return {
+    position: [home[0] - dx * back + dz * side, water ? 0 : 120 + Math.floor(slot / 3) * 15,
+      home[2] - dz * back - dx * side],
+    yaw: Math.atan2(-dx, -dz), onGround: false,
+  }
+}
