@@ -0,0 +1,143 @@
+import type { Vec3, VehicleEntity } from "./types"
+
+export interface CtfFlag {
+  team: 0 | 1
+  home: Vec3
+  position: Vec3
+  carrierId: string | null
+  droppedAt: number | null
+}
+
+export interface CtfState {
+  flags: [CtfFlag, CtfFlag]
+  scores: [number, number]
+  captureLimit: number
+}
+
+export interface CtfEvent {
+  type: "flag"
+  action: "pickup" | "drop" | "return" | "capture"
+  /** Flag owner, not the capturing team. */
+  team: 0 | 1
+  vehicleId: string | null
+  reason?: "touch" | "timeout" | "death" | "missing" | "empty"
+}
+
+const PICKUP_RADIUS_SQUARED = 40 * 40
+const RETURN_SECONDS = 30
+const CARRIER_OFFSET = 2
+
+export function createCtfState(homes: [Vec3, Vec3], captureLimit: number): CtfState {
+  if (!Number.isInteger(captureLimit) || captureLimit < 1 || captureLimit > 1000) {
+    throw new RangeError("CTF capture limit must be an integer from 1 to 1000")
+  }
+  if (homes.length !== 2 || homes.some(home => home.length !== 3 || !home.every(Number.isFinite))) {
+    throw new RangeError("CTF requires two finite 3D homes")
+  }
+  const flag = (team: 0 | 1): CtfFlag => ({
+    team, home: [...homes[team]], position: [...homes[team]], carrierId: null, droppedAt: null,
+  })
+  return { flags: [flag(0), flag(1)], scores: [0, 0], captureLimit }
+}
+
+export function cloneCtfState(state: CtfState): CtfState {
+  const flag = (value: CtfFlag): CtfFlag => ({ ...value, home: [...value.home], position: [...value.position] })
+  return {
+    flags: [flag(state.flags[0]), flag(state.flags[1])],
+    scores: [...state.scores], captureLimit: state.captureLimit,
+  }
+}
+
+function eligible(vehicle: VehicleEntity): boolean {
+  return vehicle.alive && vehicle.hp > 0 && (vehicle.team === 0 || vehicle.team === 1)
+    && (vehicle.seats[0] !== null || vehicle.seats[1] !== null)
+}
+
+function near(a: Vec3, b: Vec3): boolean {
+  return (a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2 + (a[2] - b[2]) ** 2 <= PICKUP_RADIUS_SQUARED
+}
+
+function home(flag: CtfFlag): boolean {
+  return flag.carrierId === null && flag.droppedAt === null
+}
+
+function reset(flag: CtfFlag): void {
+  flag.carrierId = null
+  flag.droppedAt = null
+  flag.position = [...flag.home]
+}
+
+function follow(flag: CtfFlag, vehicle: VehicleEntity): void {
+  const p = vehicle.flight.position
+  flag.position[0] = p[0]
+  flag.position[1] = p[1] + CARRIER_OFFSET
+  flag.position[2] = p[2]
+}
+
+/** Room-time seconds. Stable flag order, then input vehicle order breaks touch ties.
+ * Loss/timeout precedes touches; touches precede captures. Each flag transitions at most once per tick.
+ * Vehicles and their movement/combat state are read-only to this authority.
+ */
+export function stepCtf(
+  state: CtfState,
+  vehicles: readonly VehicleEntity[],
+  now: number,
+  surfaceHeight: (x: number, z: number) => number,
+  emit: (event: CtfEvent) => void,
