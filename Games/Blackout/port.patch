diff --git a/games/blackout/src/check-solo.ts b/games/blackout/src/check-solo.ts
new file mode 100644
index 0000000..e79935f
--- /dev/null
+++ b/games/blackout/src/check-solo.ts
@@ -0,0 +1,87 @@
+import { SandboxSession } from "./game/game"
+import { Hud } from "./ui/hud"
+import { LocalSession } from "./game/session"
+import { Menus } from "./ui/menus"
+import { Rng } from "../shared/rng"
+import { NO_INTENT } from "../shared/sim/world"
+
+const assert = (ok: unknown, message: string) => { if (!ok) throw new Error(message) }
+const output = document.getElementById("result")!
+try {
+  const s = new SandboxSession("solo-check", "rifle", "frag", 1)
+  const me = s.world.players.get(s.myId)!
+  const start = { x: me.x, y: me.y }
+  assert(s.latest().snap.phase === "play" && me.alive, "solo must start alive in play")
+  assert(s.world.players.size === 4 && s.passive, "expected player and three passive targets")
+  const target = [...s.world.players.values()].find(p => !p.human)!
+  const targetStart = { x: target.x, y: target.y }
+  let seq = 0
+  let shots = 0
+  // Try each normal movement direction in the generated room, without teleporting.
+  for (const [mx, my] of [[1, 0], [0, 1], [-1, 0], [0, -1]]) {
+    // Run beyond the upstream 0.5-second spawn firing cooldown.
+    for (let i = 0; i < 90; i++) {
+      s.send({ type: "intent", seq: ++seq, i: { ...NO_INTENT, mx, my, fire: true } })
+      s.update(1 / 60)
+      shots += s.drainEvents().filter(e => e.k === "shot" && e.by === s.myId).length
+    }
+    if (Math.hypot(me.x - start.x, me.y - start.y) > 0.1) break
+  }
+  const moved = Math.hypot(me.x - start.x, me.y - start.y)
+  assert(moved > 0.1, "movement must change position")
+  assert(shots > 0, "fire must emit a shot")
+  assert(target.x === targetStart.x && target.y === targetStart.y, "passive target moved")
+  s.send({ type: "gun", gun: "shotgun" })
+  assert(me.gun === "shotgun", "weapon switching failed")
+  s.toggleBots()
+  assert(!s.passive && s.status().includes("LIVE BOTS"), "live bots toggle failed")
+  s.toggleBots()
+  assert(s.passive, "passive toggle failed")
+  const reset = new SandboxSession("solo-check", "rifle", "frag", 1)
+  const resetMe = reset.world.players.get(reset.myId)!
+  assert(resetMe.alive && resetMe.x === start.x && resetMe.y === start.y, "seed reset failed")
+  const hud = new Hud(document.getElementById("hud")!)
+  hud.show(true)
+  assert(document.getElementById("hud")!.children.length > 0, "HUD did not initialize")
+  const random = Math.random
+  const rng = new Rng(1)
+  let match: LocalSession
+  try { Math.random = () => rng.next(); match = new LocalSession("match-check", "rifle", "frag", "ffa", "office") }
+  finally { Math.random = random }
+  const firstMap = match.latest()!.snap.map
+  let deaths = 0, respawns = 0, kills = 0, ended = false, replayed = false, alive = true
+  for (let i = 0; i < 60 * 320; i++) {
+    match.send({ type: "intent", seq: i + 1, i: { ...NO_INTENT } })
+    match.update(1 / 60)
+    const snap = match.latest()!.snap
+    const living = snap.you!.health > 0
+    if (alive && !living) deaths++
+    if (!alive && living) respawns++
+    alive = living
+    kills = Math.max(kills, match.roster().reduce((sum, p) => sum + p.kills, 0))
+    ended ||= snap.phase === "end"
+    replayed ||= ended && snap.phase === "play" && snap.map !== firstMap
+    match.drainEvents()
+  }
+  assert(deaths > 0 && respawns > 0 && kills > 0 && ended && replayed, "bot match must score, kill, respawn, end and replay")
+  match.send({ type: "host", action: "reset", newFloor: true })
+  match.update(0.1)
+  assert(match.latest()!.snap.phase === "play" && match.roster().every(p => p.kills === 0 && p.deaths === 0), "fresh match reset failed")
+  const root = document.createElement("div")
+  document.body.append(root)
+  let picked = ""
+  const menus = new Menus(root, "check", {
+    create: (_name, mode, maps) => { picked = `${mode}/${maps}` }, sandbox: () => {},
+    vote: () => {}, team: () => {}, shuffle: () => {}, maps: () => {}, host: () => {},
+  })
+  menus.landing()
+  root.querySelector<HTMLButtonElement>('[data-act="mode"][data-mode="ffa"]')!.click()
+  root.querySelector<HTMLButtonElement>('[data-act="map"][data-map="office"]')!.click()
+  root.querySelector<HTMLButtonElement>('[data-act="create"]')!.click()
+  assert(picked === "ffa/office" && !root.querySelector('[data-act="join"]'), "offline menu routing failed")
+  root.remove()
+  output.textContent = `PASS: sandbox seed 1, movement ${moved.toFixed(3)}, shots ${shots}, weapon/bot toggle/reset, HUD; LocalSession deaths ${deaths}, respawns ${respawns}, scored kills ${kills}, end ${ended}, replay ${replayed}, fresh reset; menu mode/map routing. Rendering not tested.`
+} catch (error) {
+  output.textContent = `FAIL: ${error instanceof Error ? error.message : error}`
+  throw error
+}
