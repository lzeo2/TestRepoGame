diff --git a/games/getaway/src/ui/solo-controls.ts b/games/getaway/src/ui/solo-controls.ts
new file mode 100644
index 0000000..1192b08
--- /dev/null
+++ b/games/getaway/src/ui/solo-controls.ts
@@ -0,0 +1,36 @@
+import type { Controls } from "../game/input"
+import { VEHICLES } from "../../shared/config"
+
+/** Bind the shell before requesting a GPU, so every failure still has a restart. */
+export function soloSetup() {
+  document.getElementById("solo-reset")!.addEventListener("click", () => location.reload())
+  const q = new URLSearchParams(location.search)
+  const mode = document.getElementById("solo-mode") as HTMLSelectElement
+  mode.value = q.get("peaceful") === "1" ? "1" : "0"
+  const picks = { robber: "muscle", cop: "cruiser" }
+  for (const role of ["robber", "cop"] as const) {
+    const select = document.getElementById(`solo-${role}`) as HTMLSelectElement
+    for (const vehicle of VEHICLES.filter(v => v.role === role)) select.add(new Option(vehicle.name, vehicle.id))
+    const requested = q.get(role)
+    if (VEHICLES.some(v => v.role === role && v.id === requested)) picks[role] = requested!
+    select.value = picks[role]
+  }
+  document.getElementById("solo-mode-label")!.textContent = mode.value === "1" ? "Free drive - no cops or rounds" : "Offline chase - bot cops and rounds"
+  return picks
+}
+
+export function soloControls(controls: Controls) {
+  document.querySelector(".solo-help")!.addEventListener("focusin", () => controls.release())
+  for (const button of document.querySelectorAll<HTMLButtonElement>(".solo-touch button")) {
+    const { code, key } = button.dataset
+    button.addEventListener("pointerdown", (event) => {
+      event.preventDefault()
+      button.setPointerCapture(event.pointerId)
+      controls.key("keydown", code!, key!)
+    })
+    const release = () => controls.key("keyup", code!, key!)
+    button.addEventListener("pointerup", release)
+    button.addEventListener("pointercancel", release)
+    button.addEventListener("lostpointercapture", release)
+  }
+}
