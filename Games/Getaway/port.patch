diff --git a/games/getaway/src/ui/solo-controls.ts b/games/getaway/src/ui/solo-controls.ts
new file mode 100644
index 0000000..ec6750b
--- /dev/null
+++ b/games/getaway/src/ui/solo-controls.ts
@@ -0,0 +1,17 @@
+import type { Controls } from "../game/input"
+
+export function soloControls(controls: Controls) {
+  document.getElementById("solo-reset")!.addEventListener("click", () => location.reload())
+  for (const button of document.querySelectorAll<HTMLButtonElement>(".solo-touch button")) {
+    const { code, key } = button.dataset
+    button.addEventListener("pointerdown", (event) => {
+      event.preventDefault()
+      button.setPointerCapture(event.pointerId)
+      controls.key("keydown", code!, key!)
+    })
+    const release = () => controls.key("keyup", code!, key!)
+    button.addEventListener("pointerup", release)
+    button.addEventListener("pointercancel", release)
+    button.addEventListener("lostpointercapture", release)
+  }
+}
